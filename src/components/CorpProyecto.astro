---
// Formulario "Hablemos" sobre foto de fondo (el envío es de demostración)
import Foto from './Foto.astro';
import { infra, servicios } from '../data/corp.js';
const c = import.meta.env.BASE_URL + 'corp/';
---
<section class="project" id="proyecto">
  <Foto id={9} alt="" widths={[640, 1000, 1600]} sizes="100vw" quality={45} />
  <div class="wrap">
    <div class="project-box">
      <h2>Hablemos sobre el próximo paso de tu organización</h2>
      <p>Si estás evaluando modernizar tu tecnología o escalar tu operación, contanos. Es una demo: usá datos de prueba, no se guarda nada.</p>
      <form class="contact" action={c + 'gracias/'} method="get">
        <div class="row">
          <label>Nombre completo<input type="text" name="nombre" autocomplete="name" required minlength="2" placeholder="Tu nombre y apellido"></label>
          <label>Empresa<input type="text" name="empresa" autocomplete="organization" placeholder="Ej: Empresa Demo"></label>
        </div>
        <div class="row">
          <label>Correo electrónico<input type="email" name="email" autocomplete="email" inputmode="email" required placeholder="tu@empresa.example"></label>
          <label>Me interesa
            <select name="interes" required>
              <option value="" disabled selected>Elegí una opción</option>
              {[...infra, ...servicios].map((x) => <option>{x.titulo}</option>)}
            </select>
          </label>
        </div>
        <label>Mensaje<textarea name="mensaje" required minlength="10" placeholder="Contanos brevemente qué necesitás"></textarea></label>
        <button class="btn" type="submit">Enviar</button>
      </form>
    </div>
  </div>
</section>
