---
// Listado de tarjetas de una sección (infraestructura, servicios, experiencias)
import Corp from '../layouts/Corp.astro';
import Foto from './Foto.astro';
const { titulo, intro, items, ruta, actual, etiqueta = 'Ver más', tituloItem = (x) => x.titulo } = Astro.props;
const c = import.meta.env.BASE_URL + 'corp/';
---
<Corp title={`${titulo} | Nodo Tecnología S.A. (demo)`} actual={actual} description={intro}>
  <div class="pagehead"><div class="wrap"><h1>{titulo}</h1><p>{intro}</p></div></div>
  <section class="s">
    <div class="wrap">
      <div class="grid">
        {items.map((x, i) => (
          <article class="card">
            <Foto id={x.foto} alt="" eager={i < 2} />
            <div><h2 style="font-size:1.15rem;margin:0">{tituloItem(x)}</h2><p>{x.resumen}</p><a class="more" href={`${c}${ruta}/${x.slug}/`}>{etiqueta}<span class="sr"> de {tituloItem(x)}</span></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="band">
    <div class="wrap"><h2>¿Hablamos de tu proyecto?</h2><p>Contanos qué necesitás y te respondemos en menos de un día hábil.</p><a class="cta solid" href={c + 'contacto/'}>Hablemos</a></div>
  </section>
</Corp>
