---
// Cinta de cifras bajo el hero: desplazamiento continuo en CSS (sin JavaScript)
import { cinta } from '../data/corp.js';
---
<section class="strip" aria-label="Cifras de la empresa">
  <div class="ticker">
    <ul class="track">
      {cinta.map(([n, t]) => <li><b>{n}</b> <span>{t}</span></li>)}
      {cinta.map(([n, t]) => <li aria-hidden="true"><b>{n}</b> <span>{t}</span></li>)}
    </ul>
  </div>
</section>
