---
import Corp from '../../layouts/Corp.astro';
import Foto from '../../components/Foto.astro';
import { numeros } from '../../data/corp.js';
const c = import.meta.env.BASE_URL + 'corp/';
---
<Corp title="Nosotros | Nodo Tecnología S.A. (demo)" actual="nosotros" description="Quiénes somos: un equipo de tecnología que acompaña a empresas. Sitio de demostración con datos ficticios.">
  <div class="pagehead"><div class="wrap"><h1>Nosotros</h1><p>Un equipo de especialistas que hace que la tecnología trabaje para tu negocio y no al revés.</p></div></div>

  <section class="s">
    <div class="wrap two">
      <div class="prose">
        <h2>Quiénes somos</h2>
        <p>Nodo Tecnología S.A. es una empresa ficticia creada para esta demostración. Imaginamos una compañía de servicios de TI con más de quince años de trayectoria, que acompaña a empresas de distintos tamaños en la operación y evolución de su tecnología.</p>
        <p>Creemos que la tecnología buena es la que no se nota: funciona, es segura y deja a las personas concentrarse en lo importante.</p>
      </div>
      <Foto id={4} alt="Persona tomando notas frente a una computadora portátil" sizes="(max-width: 50rem) 100vw, 560px" />
    </div>
  </section>

  <section class="s alt">
    <div class="wrap">
      <h2>Nuestros valores</h2>
      <div class="grid" style="margin-top:1.25rem">
        <div class="card"><div><h3>Claridad</h3><p>Explicamos todo en un idioma que se entiende, sin jerga innecesaria.</p></div></div>
        <div class="card"><div><h3>Responsabilidad</h3><p>Si algo está a nuestro cargo, respondemos por el resultado.</p></div></div>
        <div class="card"><div><h3>Mejora continua</h3><p>Medimos, aprendemos y ajustamos. Siempre se puede hacer mejor.</p></div></div>
      </div>
    </div>
  </section>

  <section class="s">
    <div class="wrap two">
      <Foto id={8} alt="Computadora portátil, libreta y café sobre una mesa de madera" sizes="(max-width: 50rem) 100vw, 560px" />
      <div class="prose">
        <h2>En números</h2>
        <div class="nums" style="text-align:left;margin-top:1rem">
          {numeros.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}
        </div>
        <p style="margin-top:1.5rem"><a class="cta line" href={c + 'contacto/'}>Conocenos, hablemos</a></p>
      </div>
    </div>
  </section>
</Corp>
