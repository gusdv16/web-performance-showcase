---
import Corp from '../../layouts/Corp.astro';
import Foto from '../../components/Foto.astro';
import Metricas from '../../components/CorpMetricas.astro';
import PorQue from '../../components/CorpPorQue.astro';
import Aliados from '../../components/CorpAliados.astro';
import Testimonios from '../../components/CorpTestimonios.astro';
import Proyecto from '../../components/CorpProyecto.astro';
import { infra, servicios, casos, numeros, clientes, faqs } from '../../data/corp.js';
const c = import.meta.env.BASE_URL + 'corp/';
---
<Corp title="Nodo Tecnología S.A. | Infraestructura y servicios de TI (demo)" actual="inicio">
  <div class="hero">
    <div class="wrap">
      <div>
        <h1>Tecnología para que tu negocio <em>no se detenga.</em></h1>
        <p>Infraestructura, soporte, consultoría y desarrollo en un solo lugar. Somos el socio que te acompaña en cada paso de tu evolución digital.</p>
        <div class="btns">
          <a class="cta dark" href={c + 'contacto/'}>Hablemos →</a>
          <a class="cta" href="#servicios">Ver soluciones</a>
        </div>
      </div>
      <svg viewBox="0 0 400 300" aria-hidden="true" focusable="false">
        <circle cx="70" cy="215" r="48" fill="#fff" opacity=".18"/>
        <rect x="110" y="40" width="96" height="230" rx="48" transform="rotate(-28 158 155)" fill="#fff" opacity=".2"/>
        <rect x="215" y="40" width="96" height="230" rx="48" transform="rotate(-28 263 155)" fill="#fff" opacity=".2"/>
        <circle cx="340" cy="70" r="40" fill="#8fd3ff" opacity=".35"/>
      </svg>
    </div>
  </div>
  <Metricas />

  <section class="s" id="servicios">
    <div class="wrap">
      <h2>Servicios y soluciones</h2>
      <p class="lead">Desde el soporte del día a día hasta proyectos a medida.</p>
      <div class="grid">
        {servicios.map((s) => (
          <article class="card">
            <Foto id={s.foto} alt="" />
            <div><h3>{s.titulo}</h3><p>{s.resumen}</p><a class="more" href={`${c}servicios/${s.slug}/`} aria-label={`Ver ${s.titulo}`}>Ver más</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <PorQue />

  <section class="s">
    <div class="wrap">
      <h2>Infraestructura TI</h2>
      <p class="lead">La base sobre la que corre tu empresa, bien diseñada y bien mantenida.</p>
      <div class="grid">
        {infra.map((s) => (
          <article class="card">
            <Foto id={s.foto} alt="" />
            <div><h3>{s.titulo}</h3><p>{s.resumen}</p><a class="more" href={`${c}infraestructura/${s.slug}/`} aria-label={`Ver ${s.titulo}`}>Ver más</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Aliados />
  <Testimonios />

  <section class="s">
    <div class="wrap">
      <h2>Experiencias</h2>
      <p class="lead">Casos de empresas que confiaron en nosotros (ficticios).</p>
      <div class="grid">
        {casos.map((s) => (
          <article class="card">
            <Foto id={s.foto} alt="" />
            <div><h3>{s.cliente}</h3><p>{s.resumen}</p><a class="more" href={`${c}experiencias/${s.slug}/`} aria-label={`Ver el caso de ${s.cliente}`}>Ver caso</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="s">
    <div class="wrap">
      <h2>Empresas que trabajan con nosotros</h2>
      <p class="lead">Nombres ficticios, para ilustrar la sección de clientes.</p>
      <div class="marquee" role="group" aria-label="Clientes (ficticios)">
        <div class="track">
          {clientes.map((n) => <span>{n}</span>)}
          {clientes.map((n) => <span aria-hidden="true">{n}</span>)}
        </div>
      </div>
      <div class="marquee rev" aria-hidden="true">
        <div class="track">
          {[...clientes].reverse().map((n) => <span>{n}</span>)}
          {[...clientes].reverse().map((n) => <span>{n}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="s alt">
    <div class="wrap">
      <h2>Preguntas frecuentes</h2>
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <Proyecto />
</Corp>
